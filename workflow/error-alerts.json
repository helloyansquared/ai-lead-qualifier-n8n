{
  "name": "AI Lead Qualifier – error alerts",
  "nodes": [
    {
      "id": "e1",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "e2",
      "name": "Slack: workflow failed",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#sales-leads"
        },
        "text": "=Lead workflow failed at node *{{ $json.execution.lastNodeExecuted }}*: {{ $json.execution.error.message }}\nExecution: {{ $json.execution.url }}\nCheck the Leads sheet: the lead may need manual follow-up.",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Slack: workflow failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
